  "dependencies": {
    "diacritics": "1.3.0"
  },
  "devDependencies": {
    "@types/node": "24.0.15",
    "@vitest/coverage-v8": "4.1.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "tsdown": "0.22.14",
    "bumpp": "^11.0.1",
    "cldr-core": "48.2.0",
    "cldr-localenames-full": "48.2.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "browser": "./dist/index.mjs",
  "unpkg": "./dist/browser.iife.js",
  "jsdelivr": "./dist/browser.iife.js",
  "exports": {
    ".": {
      "browser": {
        "import": {
          "types": "./dist/index.d.mts",
          "default": "./dist/index.mjs"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        },
        "default": "./dist/index.mjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.mjs"
    },
    "./browser": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./browser.iife.js": "./dist/browser.iife.js",
    "./browser.umd.js": "./dist/browser.umd.js",
    "./locales/*.json": "./locales/*.json",
    "./codes.json": "./codes.json",
    "./locales.json": "./locales.json",
    "./territoryAliases.json": "./territoryAliases.json",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=12"
  },
  "packageManager": "pnpm@11.15.1",
  "files": [
    "dist",
    "locales",
    "codes.json",
    "locales.json",
    "territoryAliases.json",
    "LICENSE",
    "LICENSE-CLDR",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "format": "oxfmt src test scripts tsdown.config.mts vitest.config.ts",
    "format:check": "oxfmt --check src test scripts tsdown.config.mts vitest.config.ts",
    "lint": "oxlint src test scripts tsdown.config.mts vitest.config.ts",
    "cldr:generate": "node scripts/generate-cldr.mjs",
    "cldr:update": "node scripts/generate-cldr.mjs --version",
    "cldr:check": "node scripts/generate-cldr.mjs --check",
    "prepare": "pnpm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "release": "bumpp",
    "release:initial": "bumpp --release 1.0.0",
    "release:patch": "bumpp --release patch",
    "release:minor": "bumpp --release minor",
    "release:major": "bumpp --release major",
    "upstream:set": "node scripts/update-upstream.mjs",
    "prepublishOnly": "pnpm run build",
    "check": "pnpm run cldr:check && pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:coverage && pnpm run build"
  }
}
